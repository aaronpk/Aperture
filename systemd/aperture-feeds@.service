# Aperture feed fetch worker. One instance handles one fetch at a time; the number of
# instances is set in aperture-workers.target.
[Unit]
Description=Aperture feed fetch worker %i
After=network-online.target redis-server.service mariadb.service
Wants=network-online.target
# Stopping or restarting aperture-workers.target does the same to this unit
PartOf=aperture-workers.target

[Service]
# The same user as PHP-FPM: workers share storage/ and /tmp/aperture with it
User=www-data
Group=www-data
WorkingDirectory=/web/sites/aperture.p3k.app/aperture
ExecStart=/usr/bin/php8.6 artisan queue:work --name=aperture-feeds-%i --queue=feeds --sleep=3 --max-time=3600
# The worker exits after an hour (--max-time) and is started fresh, which keeps memory in check
Restart=always
RestartSec=5
# Let a fetch that is in progress finish before the worker is stopped
TimeoutStopSec=90
KillSignal=SIGTERM

[Install]
WantedBy=aperture-workers.target
